use Corsair\Console\AddCommand;
use Corsair\Console\InstallCommand;
use Corsair\Console\MahoCommand;
use Corsair\Console\MahoInstallCommand;
use Corsair\Console\PublishCommand;
use Symfony\Component\Console\Application;

$autoloadCandidates = [
    dirname(__DIR__) . '/vendor/autoload.php',
    dirname(__DIR__, 3) . '/autoload.php',
    dirname(__DIR__, 4) . '/autoload.php',
];

$autoload = null;

foreach ($autoloadCandidates as $candidate) {
    if (file_exists($candidate)) {
        $autoload = $candidate;
        break;
    }
}

if ($autoload === null) {
    fwrite(STDERR, "Unable to find Composer autoloader.\n");
    exit(1);
}

require $autoload;

if (($argv[1] ?? null) === 'maho') {
    $command = (new MahoCommand())->setProjectPath(getcwd() ?: '.');
    exit($command->forward(array_slice($argv, 2)));
}

$application = new Application('Corsair', '0.1.0');
$application->addCommands([
    new InstallCommand(),
    new AddCommand(),
    new PublishCommand(),
    new MahoCommand(),
    new MahoInstallCommand(),
]);
$application->run();
