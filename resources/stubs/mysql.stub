mysql:
    image: 'mysql:8.4'
    # mysql:8.4 enables binary logging by default. Magento 2's schema setup
    # creates triggers (e.g. the indexer changelog tables), which MySQL
    # refuses for a non-SUPER user while binlog is on ("You do not have the
    # SUPER privilege and binary logging is enabled") — there's no
    # replication to serve in a local dev stack, so just turn it off.
    command: --disable-log-bin
    ports:
        - '${FORWARD_DB_PORT:-3306}:3306'
    environment:
        MYSQL_ROOT_PASSWORD: '${DB_PASSWORD}'
        MYSQL_ROOT_HOST: '%'
        MYSQL_DATABASE: '${DB_DATABASE}'
        MYSQL_USER: '${DB_USERNAME}'
        MYSQL_PASSWORD: '${DB_PASSWORD}'
        MYSQL_ALLOW_EMPTY_PASSWORD: 1
        MYSQL_EXTRA_OPTIONS: '${MYSQL_EXTRA_OPTIONS:-}'
    volumes:
        - 'corsair-mysql:/var/lib/mysql'
        - './vendor/maco-studios/corsair/resources/database/mysql/create-testing-database.sh:/docker-entrypoint-initdb.d/10-create-testing-database.sh'
    networks:
        - corsair
    healthcheck:
        test: ["CMD", "mysqladmin", "ping", "-p${DB_PASSWORD}"]
        retries: 3
        timeout: 5s
