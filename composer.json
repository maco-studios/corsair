{
    "name": "maco-studios/corsair",
    "description": "Docker-powered local dev environment for Magento 1, Magento 2, OpenMage, Mage-OS, and MahoCommerce.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "magento",
        "magento2",
        "openmage",
        "mage-os",
        "maho",
        "mahocommerce",
        "docker",
        "sail",
        "dev-environment"
    ],
    "authors": [
        {
            "name": "Marcos \"Marcão\" Aurelio",
            "email": "macosaures@gmail.com"
        }
    ],
    "homepage": "https://github.com/maco-studios/corsair",
    "support": {
        "issues": "https://github.com/maco-studios/corsair/issues",
        "source": "https://github.com/maco-studios/corsair"
    },
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "composer/semver": "^3.0",
        "symfony/console": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/process": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/yaml": "^5.4 || ^6.0 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.56",
        "ergebnis/license": "^2.9",
        "friendsofphp/php-cs-fixer": "^3.95",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^5.3",
        "rector/rector": "^2.8"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Corsair\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/corsair"
    ],
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@composer normalize"
        ],
        "post-update-cmd": [
            "@composer normalize"
        ],
        "test": "pest --exclude-group=e2e",
        "test:e2e": "CORSAIR_E2E=1 pest --group=e2e"
    }
}
