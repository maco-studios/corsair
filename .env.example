# Copy this file to .env (gitignored) and fill in real values.
# tests/Pest.php loads .env automatically before the suite runs.

# repo.magento.com Marketplace keys, used as Basic Auth credentials to
# `composer create-project magento/project-community-edition` for the real
# Magento 2 end-to-end test. Get them from your Adobe Commerce Marketplace
# account under "Access Keys": https://developer.adobe.com/commerce/marketplace/
# The "public key" is the Basic Auth username, the "private key" is the password.
ADOBE_COMMERCE_PUBLIC_KEY=
ADOBE_COMMERCE_PRIVATE_KEY=
